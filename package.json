{
  "name": "mirlo",
  "description": "Another Simple JavaScript WC",
  "version": "0.8.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "keywords": [
    "webcomponent",
    "simple",
    "javascript",
    "browser"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "dist/"
  ],
  "main": "./dist/mirlo.mjs",
  "exports": {
    ".": {
      "default": "./dist/mirlo.mjs"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Tardo/mirlo.git"
  },
  "author": "Alexandre",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Tardo/mirlo/issues"
  },
  "homepage": "https://github.com/Tardo/mirlo#readme",
  "scripts": {
    "prepare": "husky",
    "clean": "rm -rf ./dist",
    "lint": "eslint --color .",
    "watch": "rollup -c -w",
    "build": "rollup -c",
    "flowcheck": "flow check",
    "test": "pnpm run build && NODE_OPTIONS=--experimental-vm-modules jest",
    "generate-docs": "node scripts/generate-docs.mjs"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-flow": "^7.27.1",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-hermes": "^0.2.4",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "babel-plugin-syntax-hermes-parser": "^0.37.0",
    "docdash": "^2.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-prettier": "^5.5.7",
    "flow-bin": "^0.340",
    "globals": "^17.14.0",
    "hermes-eslint": "^0.37",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdoc": "^4.0.5",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "rollup": "^4.68.5",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-cleanup": "^3.2.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "NODE_OPTIONS=--experimental-vm-modules jest"
    }
  },
  "lint-staged": {
    "*": [
      "prettier --write"
    ],
    "*.{mjs,js}": [
      "eslint --color --fix"
    ]
  },
  "babel": {
    "targets": {
      "esmodules": true
    },
    "presets": [
      "@babel/preset-env",
      "@babel/preset-flow"
    ],
    "plugins": [
      "babel-plugin-syntax-hermes-parser"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/?(*.)test.?js"
    ],
    "moduleFileExtensions": [
      "js",
      "mjs"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": false,
    "bracketSameLine": false,
    "arrowParens": "avoid",
    "requirePragma": false,
    "proseWrap": "always",
    "htmlWhitespaceSensitivity": "css",
    "vueIndentScriptAndStyle": false,
    "endOfLine": "lf",
    "embeddedLanguageFormatting": "auto",
    "singleAttributePerLine": false,
    "plugins": [
      "@prettier/plugin-hermes"
    ]
  }
}
